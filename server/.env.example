PORT=5000
NODE_ENV=development
JWT_SECRET=your_jwt_secret_here
# Short-lived now that refresh tokens exist (see below) — the access token
# only needs to survive until the client's next silent refresh.
JWT_EXPIRES_IN=15m

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password_here
DB_NAME=school_erp

CORS_ORIGIN=http://localhost:5173

# Optional — defaults shown below if unset
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=25
REFRESH_TOKEN_TTL_DAYS=30
