GET {{baseUrl}}/expense-categories?status=ACTIVE HTTP/1.1

### get expense category by id
GET {{baseUrl}}/expense-categories/1 HTTP/1.1

### update expense category
PATCH {{baseUrl}}/expense-categories/1 HTTP/1.1
Content-Type: application/json

{
    "description": "Electricity, water, generator fuel, and gas"
}

### archive expense category
PATCH {{baseUrl}}/expense-categories/1/archive HTTP/1.1

### restore expense category
PATCH {{baseUrl}}/expense-categories/1/restore HTTP/1.1

### submit an expense (creates the record and kicks off its approval chain)
POST {{baseUrl}}/expenses HTTP/1.1
Content-Type: application/json

{
    "category_id": 1,
    "academic_year_id": 1,
    "title": "Generator fuel - January",
    "description": "Diesel for backup generator during grid outages",
    "amount": 4500,
    "expense_date": "2026-01-15",
    "vendor_name": "Serrekunda Fuel Depot",
    "payment_method": "CASH",
    "reference_number": "RCPT-2026-0114"
}

### get all expenses (filters: category_id, academic_year_id, status)
GET {{baseUrl}}/expenses HTTP/1.1

### get expenses for one academic year, still pending review
GET {{baseUrl}}/expenses?academic_year_id=1&status=PENDING_REVIEW HTTP/1.1

### get expense by id (status comes from its linked approval request)
GET {{baseUrl}}/expenses/1 HTTP/1.1

### get a per-category expense summary for an academic year
# (only counts EXECUTED expenses — see expense.repository.js getSummary)
GET {{baseUrl}}/expenses/summary?academic_year_id=1 HTTP/1.1

### approve / reject / cancel / execute an expense's approval request
# (same generic engine every other approval-gated workflow uses)
PATCH {{baseUrl}}/approval-requests/1/approve HTTP/1.1
Content-Type: application/json

{
    "comment": "Reasonable and within this month's budget."
}

### export the expenses dataset as an Excel file
GET {{baseUrl}}/reports/expenses/download?format=xlsx&academic_year_id=1 HTTP/1.1

###############################################
# Calendar
###############################################

### add a fixed-date public holiday
POST {{baseUrl}}/calendar-events HTTP/1.1
Content-Type: application/json

{
    "academic_year_id": 1,
    "title": "Independence Day",
    "category": "Public Holiday",
    "start_date": "2026-02-18",
    "end_date": "2026-02-18",
    "is_school_closed": true
}

### add a movable-date holiday (Islamic calendar — entered explicitly each year, never auto-repeated)
POST {{baseUrl}}/calendar-events HTTP/1.1
Content-Type: application/json

{
    "academic_year_id": 1,
    "title": "Eid al-Fitr",
    "category": "Religious Holiday",
    "start_date": "2026-03-20",
    "end_date": "2026-03-21",
    "is_school_closed": true
}

### add a school event that isn't a closure (teaching continues)
POST {{baseUrl}}/calendar-events HTTP/1.1
Content-Type: application/json

{
    "academic_year_id": 1,
    "title": "Inter-House Sports Day",
    "category": "School Event",
    "start_date": "2026-04-10",
    "end_date": "2026-04-10",
    "is_school_closed": false
}

### get every calendar event for an academic year
GET {{baseUrl}}/calendar-events?academic_year_id=1 HTTP/1.1

### get only the events that close the school
GET {{baseUrl}}/calendar-events?academic_year_id=1&category=Public%20Holiday HTTP/1.1

### get events overlapping a date range (for a calendar month/week view)
GET {{baseUrl}}/calendar-events?from=2026-02-01&to=2026-02-28 HTTP/1.1

### get one event
GET {{baseUrl}}/calendar-events/1 HTTP/1.1

### update an event (e.g. correcting a movable holiday's date once confirmed)
PATCH {{baseUrl}}/calendar-events/2 HTTP/1.1
Content-Type: application/json

{
    "start_date": "2026-03-21",
    "end_date": "2026-03-22"
}

### archive an event entered by mistake
PATCH {{baseUrl}}/calendar-events/3/archive HTTP/1.1

### restore it
PATCH {{baseUrl}}/calendar-events/3/restore HTTP/1.1

### copy last year's calendar into the new academic year as a starting point
# (movable-date entries still need manual review afterward — see the module's comments)
POST {{baseUrl}}/calendar-events/copy HTTP/1.1
Content-Type: application/json

{
    "source_academic_year_id": 1,
    "target_academic_year_id": 2
}
