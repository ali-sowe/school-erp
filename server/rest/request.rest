###############################################
# Approval Workflow Engine
# Generic engine: any module can route a decision through this instead of
# applying it immediately. Lifecycle: PENDING_REVIEW -> APPROVED -> EXECUTED
# (or REJECTED/CANCELLED). See workflow-executor-registry.js for which
# workflow_types currently have a registered executor (INVOICE_VOID,
# PAYMENT_VOID, STUDENT_TRANSFER).
###############################################

### create an approval request with a two-step chain (named user, then any Administrator)
POST {{baseUrl}}/approval-requests HTTP/1.1
Content-Type: application/json

{
    "workflow_type": "INVOICE_VOID",
    "entity_type": "Invoice",
    "entity_id": 1,
    "title": "Void invoice #1 - issued to wrong student",
    "description": "Invoice was generated for the wrong student during bulk generation.",
    "metadata": { "invoice_id": 1, "reason": "Issued to wrong student" },
    "steps": [
        { "approver_user_id": 2 },
        { "approver_role_name": "Administrator" }
    ]
}

### get all approval requests (filters: status, workflow_type, entity_type, entity_id)
GET {{baseUrl}}/approval-requests HTTP/1.1

### get requests waiting on my decision
GET {{baseUrl}}/approval-requests/my-pending HTTP/1.1

### get approval request by id (includes its full step chain)
GET {{baseUrl}}/approval-requests/1 HTTP/1.1

### approve the current step
PATCH {{baseUrl}}/approval-requests/1/approve HTTP/1.1
Content-Type: application/json

{
    "comment": "Confirmed with the office - approved."
}

### reject the current step (rejects the whole request)
PATCH {{baseUrl}}/approval-requests/1/reject HTTP/1.1
Content-Type: application/json

{
    "comment": "Need the original enrollment record before this can be voided."
}

### execute a fully-approved request (runs the registered executor, if any)
PATCH {{baseUrl}}/approval-requests/1/execute HTTP/1.1
Content-Type: application/json

{
    "note": "Executed after Finance sign-off."
}

### cancel a request still pending review (only the original requester can)
PATCH {{baseUrl}}/approval-requests/1/cancel HTTP/1.1
Content-Type: application/json

{
    "reason": "No longer needed - fixed the invoice directly instead."
}

